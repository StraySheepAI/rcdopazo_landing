# Server-only values. Never put real access codes or provider keys in committed files.
ANTHROPIC_API_KEY=
AIRTABLE_TOKEN=
DIMA_MODEL=claude-haiku-4-5-20251001

# Random session signing secret, at least 32 characters.
DIMA_SESSION_SECRET=
# SHA-256 of the normalized code; see normalizeCode() in lib/dima/access.ts.
DIMA_BOOK_CODE_HASH=
DIMA_PLUS_CODE_HASH=

# Durable Neon Postgres connection for the hosted site (server only).
DIMA_DATABASE_URL=
# Local preview only. Never use a local SQLite file on Vercel.
DIMA_SQLITE_PATH=.dima-data/dima.sqlite
# Enable the private review page only on the loopback preview.
DIMA_LOCAL_REVIEW=1
